APP_NAME="FF Creative Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8888
APP_TIMEZONE=Asia/Singapore
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=creative_monitor
DB_USERNAME=creative_monitor
DB_PASSWORD=creative_monitor

CACHE_STORE=file
SESSION_DRIVER=file

FILESYSTEM_DISK=nas
NAS_STORAGE_PATH=/mnt/creative-nas

# Docker maps this host path into the app container as /mnt/creative-nas.
# For a NAS, map the share on Windows first, then set this to that drive/folder.
# Example: NAS_HOST_PATH=Z:\CreativeMonitor
NAS_HOST_PATH=./storage/app/nas

PHPMYADMIN_PORT=8081
FFMPEG_PATH=ffmpeg
